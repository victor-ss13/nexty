# Nexty Website Environment Configuration

# Interaction 1: Call Me Now Notifications
# Optional webhook URL (Discord, Slack, Telegram bot, Zapier, Make) to receive new callback leads
# Example Discord webhook: https://discord.com/api/webhooks/...
NEXTY_NOTIFICATION_WEBHOOK=

# Interaction 2: Calendly Integration
# Your Calendly event or scheduling page URL
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com

# Interaction 3: WhatsApp Business Integration
# Phone number with country code (numbers only, no spaces or dashes)
# e.g., 15551234567 for US, 5511999999999 for Brazil
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567
